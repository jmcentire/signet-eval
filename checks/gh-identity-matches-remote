#!/usr/bin/env bash
# Verify the functional GitHub identity for the target repository.
#
# Target owner -> account/email mapping (kept in sync with the local gh and
# credential shims):
#   wandercom -> jmc-wander + jeremy@wander.com
#   meacjis   -> jmc-mea    + jeremy@mea.tech
#   otherwise -> jmcentire  + jandrewmcentire@gmail.com
#
# Exit 0 permits the pending operation. Any uncertainty fails closed.

set -uo pipefail

shim="${HOME:-}/.gh-shim/gh"
real_gh=""
while IFS= read -r candidate; do
    if [ "$candidate" != "$shim" ]; then
        real_gh="$candidate"
        break
    fi
done < <(type -a -p gh 2>/dev/null || true)
if [ -z "$real_gh" ] && [ -x "$shim" ]; then
    real_gh="$shim"
fi
if [ -z "$real_gh" ]; then
    printf 'github_identity_guard: GitHub CLI is unavailable; cannot prove the required identity.\n' >&2
    exit 1
fi

cmd="${SIGNET_TOOL_COMMAND:-}"
call_cwd="${SIGNET_TOOL_CWD:-$PWD}"
json="$(cat 2>/dev/null || true)"
if [ -z "$cmd" ] && command -v jq >/dev/null 2>&1 && [ -n "$json" ]; then
    cmd="$(printf '%s' "$json" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
fi

owner_of() {
    local value="$1"
    local first rest second
    value="${value#*://}"
    value="${value#*@}"
    if [[ "$value" == *:* ]]; then
        value="${value%%:*}/${value#*:}"
    fi
    value="${value#\"}"
    value="${value#\'}"
    value="${value%\"}"
    value="${value%\'}"
    while [[ "$value" == /* ]]; do value="${value#/}"; done
    [[ "$value" == */* ]] || return 0
    first="${value%%/*}"
    rest="${value#*/}"
    second="${rest%%/*}"
    case "$first" in
        github.com|www.github.com)
            printf '%s' "$second"
            ;;
        api.github.com)
            if [ "$second" = "repos" ] && [[ "$rest" == */* ]]; then
                rest="${rest#*/}"
                printf '%s' "${rest%%/*}"
            fi
            ;;
        repos)
            printf '%s' "$second"
            ;;
        *)
            # owner/repo shorthand, as accepted by gh --repo/-R.
            printf '%s' "$first"
            ;;
    esac
}

owner=""
git_operation=""
git_operation_candidate="$(printf '%s\n' "$cmd" | grep -oE '(^|[[:space:]])(push|pull|fetch|clone)($|[[:space:]])' | head -1 | tr -d '[:space:]' || true)"
repo_cwd="$call_cwd"
if [ -n "$git_operation_candidate" ] && \
    printf '%s\n' "$cmd" | grep -qE '(^|[^[:alnum:]_-])([^[:space:]]*/)?git([[:space:]]|$)'; then
    git_operation="$git_operation_candidate"
    # Do not guess which checkout a shell-level directory change targets.
    # The hook workdir or git -C gives us an explicit, inspectable boundary.
    if printf '%s\n' "$cmd" | grep -qE '(^|[;&|][[:space:]]*|[[:space:]])(cd|pushd)[[:space:]]'; then
        printf 'github_identity_guard: a git operation after cd/pushd has an ambiguous repository target; use the tool workdir or git -C instead.\n' >&2
        exit 1
    fi

    git_cwd=""
    if [[ "$cmd" =~ (^|[[:space:]])-C[=[:space:]]\"([^\"]+)\" ]]; then
        git_cwd="${BASH_REMATCH[2]}"
    elif [[ "$cmd" =~ (^|[[:space:]])-C[=[:space:]]\'([^\']+)\' ]]; then
        git_cwd="${BASH_REMATCH[2]}"
    else
        git_cwd="$(printf '%s\n' "$cmd" | grep -oE -- '(^|[[:space:]])-C(=|[[:space:]])[^[:space:]]+' | head -1 | sed -E 's/^[[:space:]]*-C(=|[[:space:]])//')"
    fi
    if [ -n "$git_cwd" ]; then
        case "$git_cwd" in
            /*) repo_cwd="$git_cwd" ;;
            *) repo_cwd="$call_cwd/$git_cwd" ;;
        esac
    fi
fi

if [ -n "$cmd" ]; then
    ref="$(printf '%s\n' "$cmd" | grep -oE -- '(--repo[= ]|-R )[^ ]+' | head -1 | sed -E 's/^(--repo[= ]|-R )//')"
    [ -n "$ref" ] && owner="$(owner_of "$ref")"
    if [ -z "$owner" ]; then
        owner="$(printf '%s\n' "$cmd" | grep -oE 'repos/[A-Za-z0-9_.-]+/' | head -1 | sed -E 's#^repos/##; s#/$##')"
    fi
    if [ -z "$owner" ]; then
        ref="$(printf '%s\n' "$cmd" | grep -oE '[^ "'"'"']*github\.com[^ "'"'"']*' | head -1)"
        [ -n "$ref" ] && owner="$(owner_of "$ref")"
    fi
fi
if [ -z "$owner" ]; then
    remote_name="origin"
    if [ -n "$git_operation" ] && [ "$git_operation" != "clone" ]; then
        read -r -a command_words <<< "$cmd"
        saw_operation=0
        for word in "${command_words[@]}"; do
            if [ "$saw_operation" -eq 1 ] && [[ "$word" != -* ]]; then
                if git -C "$repo_cwd" config --get "remote.$word.url" >/dev/null 2>&1; then
                    remote_name="$word"
                fi
                break
            fi
            if [ "$word" = "$git_operation" ]; then
                saw_operation=1
            fi
        done
    fi
    owner="$(owner_of "$(git -C "$repo_cwd" config --get "remote.$remote_name.url" 2>/dev/null)")"
fi
owner="$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')"

want_user="jmcentire"
want_email="jandrewmcentire@gmail.com"
case "$owner" in
    wandercom)
        want_user="jmc-wander"
        want_email="jeremy@wander.com"
        ;;
    meacjis)
        want_user="jmc-mea"
        want_email="jeremy@mea.tech"
        ;;
esac

gh_as="$(printf '%s\n' "$cmd" | grep -oE 'GH_AS=[A-Za-z0-9_-]+' | head -1 | cut -d= -f2 || true)"
gh_as="${gh_as:-${GH_AS:-}}"
if [ -n "$gh_as" ] && [ "$gh_as" != "$want_user" ]; then
    printf 'github_identity_guard: GH_AS=%s conflicts with identity %s required by repo owner %s.\n' \
        "$gh_as" "$want_user" "${owner:-<none>}" >&2
    exit 1
fi
if printf '%s' "$cmd" | grep -qE '(GH_TOKEN|GITHUB_TOKEN)=[^ ]'; then
    printf 'github_identity_guard: an inline GitHub token bypasses the remote-owner identity mapping; use the configured per-process shim.\n' >&2
    exit 1
fi
if [ -n "${GH_TOKEN:-}" ]; then
    inherited_user="$(GH_TOKEN="$GH_TOKEN" "$real_gh" api user -q .login 2>/dev/null || true)"
    if [ "$inherited_user" != "$want_user" ]; then
        printf 'github_identity_guard: inherited GH_TOKEN authenticates as %s but repo owner %s requires %s. Clear it and use the configured per-process shim.\n' \
            "${inherited_user:-nobody}" "${owner:-<none>}" "$want_user" >&2
        exit 1
    fi
fi
if [ -n "${GITHUB_TOKEN:-}" ]; then
    inherited_user="$(GH_TOKEN="$GITHUB_TOKEN" "$real_gh" api user -q .login 2>/dev/null || true)"
    if [ "$inherited_user" != "$want_user" ]; then
        printf 'github_identity_guard: inherited GITHUB_TOKEN authenticates as %s but repo owner %s requires %s. Clear it and use the configured per-process shim.\n' \
            "${inherited_user:-nobody}" "${owner:-<none>}" "$want_user" >&2
        exit 1
    fi
fi

if [ ! -x "$shim" ]; then
    active="$("$real_gh" api user -q .login 2>/dev/null || true)"
    if [ "$active" != "$want_user" ]; then
        printf 'github_identity_guard: identity shim missing; active account is %s but repo owner %s requires %s. Install the per-process identity shim; do not switch the global account.\n' \
            "${active:-unknown}" "${owner:-<none>}" "$want_user" >&2
        exit 1
    fi
elif printf '%s' "$cmd" | grep -qE '(^|[[:space:]])/(opt/homebrew|usr/local|usr)/bin/gh([[:space:]]|$)'; then
    active="$("$real_gh" api user -q .login 2>/dev/null || true)"
    if [ "$active" != "$want_user" ]; then
        printf 'github_identity_guard: absolute gh path bypasses the per-process shim; active account is %s but repo owner %s requires %s. Use plain gh.\n' \
            "${active:-unknown}" "${owner:-<none>}" "$want_user" >&2
        exit 1
    fi
else
    token="$("$real_gh" auth token --user "$want_user" 2>/dev/null || true)"
    if [ -z "$token" ]; then
        printf 'github_identity_guard: no stored login for %s (required by repo owner %s). Log that account in once; do not switch globally.\n' \
            "$want_user" "${owner:-<none>}" >&2
        exit 1
    fi
    actual="$(GH_TOKEN="$token" "$real_gh" api user -q .login 2>/dev/null || true)"
    if [ "$actual" != "$want_user" ]; then
        printf 'github_identity_guard: stored token for %s authenticates as %s; repair that account login.\n' \
            "$want_user" "${actual:-nobody}" >&2
        exit 1
    fi
fi

if [ -n "$git_operation" ] && [ "$git_operation" != "clone" ] && \
    git -C "$repo_cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    config_email="$(git -C "$repo_cwd" config user.email 2>/dev/null || true)"
    if [ "$config_email" != "$want_email" ]; then
        printf 'github_identity_guard: this repo requires git user.email %s but it is %s. Configure the repository-local email before continuing.\n' \
            "$want_email" "${config_email:-<unset>}" >&2
        exit 1
    fi
fi

exit 0
