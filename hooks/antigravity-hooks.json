{
  "signet": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -lc 'source ~/.profile >/dev/null 2>&1 || true; exec signet-eval --adapter antigravity'",
            "timeout": 30,
            "statusMessage": "Checking Signet policy"
          }
        ]
      }
    ]
  }
}
